{
  "opencollection": "1.0.0",
  "info": {
    "name": "Total Expert Public Account Endpoints Scenarios API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://public.totalexpert.net/v1/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Scenarios",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Fetch Scenario",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://public.totalexpert.net/v1/scenarios/:scenario_id",
            "params": [
              {
                "name": "scenario_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Fetch a specific scenario specified by ID."
        },
        {
          "info": {
            "name": "Update Scenario",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://public.totalexpert.net/v1/scenarios/:scenario_id",
            "params": [
              {
                "name": "scenario_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update an existing scenario by ID."
        },
        {
          "info": {
            "name": "Delete Scenario",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://public.totalexpert.net/v1/scenarios/:scenario_id",
            "params": [
              {
                "name": "scenario_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete a scenario by ID."
        },
        {
          "info": {
            "name": "Fetch Scenarios",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://public.totalexpert.net/v1/scenarios",
            "params": [
              {
                "name": "page[number]",
                "value": "1",
                "type": "query"
              },
              {
                "name": "page[size]",
                "value": "10",
                "type": "query"
              }
            ]
          },
          "docs": "Fetch a page of scenarios. Specify page size and page number via the '?page[size]' and '?page[number]' GET parameters. Can also filter by name, display_name, or expiration_date."
        },
        {
          "info": {
            "name": "Create Scenario (as Admin)",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://public.totalexpert.net/v1/scenarios",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a scenario.\n\nRequired Attributes (one of the following combinations):\n\nname, data\n\nRequired Relationships:\n\nowner*\n\ntags\n\n*required if authenticated as an organization admin"
        }
      ]
    }
  ],
  "bundled": true
}