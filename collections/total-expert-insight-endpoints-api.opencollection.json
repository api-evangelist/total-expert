{
  "opencollection": "1.0.0",
  "info": {
    "name": "Total Expert Public Account Endpoints Insight Endpoints API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://public.totalexpert.net/v1/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Insight Endpoints",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Fetch Insight Types",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://public.totalexpert.net/v1/insight-types",
            "params": [
              {
                "name": "page[number]",
                "value": "1",
                "type": "query"
              },
              {
                "name": "page[size]",
                "value": "10",
                "type": "query"
              }
            ]
          },
          "docs": "Fetch a page of insight types. Specify page size and page number via the '?page[size]' and '?page[number]' GET parameters."
        },
        {
          "info": {
            "name": "Fetch Insight",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://public.totalexpert.net/v1/insights/:insight_id",
            "params": [
              {
                "name": "insight_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Fetch a specific insight specified by ID."
        },
        {
          "info": {
            "name": "Fetch Insights",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://public.totalexpert.net/v1/insights",
            "params": [
              {
                "name": "page[number]",
                "value": "1",
                "type": "query"
              },
              {
                "name": "page[size]",
                "value": "10",
                "type": "query"
              }
            ]
          },
          "docs": "Fetch a page of insights. Specify page size and page number via the '?page[size]' and '?page[number]' GET parameters."
        },
        {
          "info": {
            "name": "Create Insight (as Admin)",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://public.totalexpert.net/v1/insights",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create an Insight.\n\nRequired Relationships:\n\nowner*\n\ntype\n\ncontact\n\n*required if authenticated as an organization admin\n\nAlternate documented request: Create Insight (as User)."
        }
      ]
    }
  ],
  "bundled": true
}