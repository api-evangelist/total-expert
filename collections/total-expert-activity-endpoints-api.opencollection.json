{
  "opencollection": "1.0.0",
  "info": {
    "name": "Total Expert Public Account Endpoints Activity Endpoints API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://public.totalexpert.net/v1/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Activity Endpoints",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Fetch Activities",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://public.totalexpert.net/v1/activity"
          },
          "docs": "Fetch Activities"
        },
        {
          "info": {
            "name": "Fetch Activity",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://public.totalexpert.net/v1/activity/:activity_id",
            "params": [
              {
                "name": "activity_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Fetch Activity"
        }
      ]
    }
  ],
  "bundled": true
}