{
  "opencollection": "1.0.0",
  "info": {
    "name": "Total Expert Public Account Endpoints Entities API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://public.totalexpert.net/v1/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Entities",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Fetch Entity",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://public.totalexpert.net/v1/entities/:entity_id",
            "params": [
              {
                "name": "entity_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Fetch a specific entity specified by ID."
        },
        {
          "info": {
            "name": "Update Entity",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://public.totalexpert.net/v1/entities/:entity_id",
            "params": [
              {
                "name": "entity_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update an existing entity by ID."
        },
        {
          "info": {
            "name": "Delete Entity",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://public.totalexpert.net/v1/entities/:entity_id",
            "params": [
              {
                "name": "entity_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete an entity by ID."
        },
        {
          "info": {
            "name": "Fetch Entities",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://public.totalexpert.net/v1/entities",
            "params": [
              {
                "name": "page[number]",
                "value": "1",
                "type": "query"
              },
              {
                "name": "page[size]",
                "value": "10",
                "type": "query"
              }
            ]
          },
          "docs": "Fetch a page of entities. Specify page size and page number via the '?page[size]' and '?page[number]' GET parameters."
        },
        {
          "info": {
            "name": "Create Entity (as Admin)",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://public.totalexpert.net/v1/entities",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create an entity."
        },
        {
          "info": {
            "name": "Fetch Entity Relationship Types",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://public.totalexpert.net/v1/entity-relationship-types",
            "params": [
              {
                "name": "page[number]",
                "value": "1",
                "type": "query"
              },
              {
                "name": "page[size]",
                "value": "10",
                "type": "query"
              }
            ]
          },
          "docs": "Fetch a page of entities. Specify page size and page number via the '?page[size]' and '?page[number]' GET parameters."
        }
      ]
    }
  ],
  "bundled": true
}