{
  "opencollection": "1.0.0",
  "info": {
    "name": "Total Expert Public Account Endpoints Webhooks API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://public.totalexpert.net/v1/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Webhooks",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Fetch Webhook Actions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://public.totalexpert.net/v1/webhook-actions"
          },
          "docs": "Fetch a page of the list of subscribable actions. Specify page size and page number via the '?page[size]' and '?page[number]' GET parameters.\n\nAttributes\n\nField\nAssignable\nType\nDescription\n\naction\nNo\nstring\nname of the subscribed verb, e.g. 'CREATED'\n\nitem\nYes\nstring\nname of the subscribed item, e.g. 'CONTACT'"
        },
        {
          "info": {
            "name": "Fetch Webhook Subscriptions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://public.totalexpert.net/v1/webhook-subscriptions",
            "params": [
              {
                "name": "page[number]",
                "value": "1",
                "type": "query"
              },
              {
                "name": "page[size]",
                "value": "10",
                "type": "query"
              }
            ]
          },
          "docs": "Fetch a page of subscriptions. Specify page size and page number via the '?page[size]' and '?page[number]' GET parameters."
        },
        {
          "info": {
            "name": "Create Webhook Subscription",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://public.totalexpert.net/v1/webhook-subscriptions",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a webhook subscription.\n\nRequired Attributes:\n\nurl\n\nRequired Relationships:\n\nactions"
        },
        {
          "info": {
            "name": "Fetch Webhook Subscription",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://public.totalexpert.net/v1/webhook-subscriptions/:subscription_id",
            "params": [
              {
                "name": "page[number]",
                "value": "1",
                "type": "query"
              },
              {
                "name": "page[size]",
                "value": "10",
                "type": "query"
              },
              {
                "name": "subscription_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Fetch a specific subscription specified by ID."
        },
        {
          "info": {
            "name": "Update Webhook Subscription",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://public.totalexpert.net/v1/webhook-subscriptions/:subscription_id",
            "params": [
              {
                "name": "subscription_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update an existing subscription by ID.\n\nThis can be used to rotate the webhook secret. The updated secret will be applied for any changes originating after the subscription is patched. Pending webhooks will still be sent using the old secret."
        },
        {
          "info": {
            "name": "Delete Webhook Subscription",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://public.totalexpert.net/v1/webhook-subscriptions/:subscription_id",
            "params": [
              {
                "name": "page[number]",
                "value": "1",
                "type": "query"
              },
              {
                "name": "page[size]",
                "value": "10",
                "type": "query"
              },
              {
                "name": "subscription_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Deletes a subscription by ID."
        }
      ]
    }
  ],
  "bundled": true
}